# =====================================================================
#  Top Gainers Bot - environment variables
# =====================================================================
#  The bot reads a file named ".env" in the project folder (not this
#  file). On your VPS:
#
#      cp .env.example .env
#      nano .env              # fill in the values
#      chmod 600 .env         # keep your secrets private
#
#  Rules: one VARIABLE=value per line, no spaces around "=", no quotes
#  needed. Lines starting with # are ignored. Never commit .env to git.
# =====================================================================


# ---------------------------------------------------------------------
#  REQUIRED - the bot will not start without these
# ---------------------------------------------------------------------

# Telegram bot token. Get it from @BotFather on Telegram (/newbot).
TELEGRAM_BOT_TOKEN=123456789:AAH-your-token-from-botfather

# MongoDB connection string. MongoDB Atlas: Cluster -> Connect -> Drivers.
# URL-encode special characters in the password (@ -> %40, # -> %23, : -> %3A).
# In Atlas "Network Access", allow your VPS's public IP.
MONGODB_URL=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority


# ---------------------------------------------------------------------
#  RECOMMENDED
# ---------------------------------------------------------------------

# Telegram user IDs allowed to use /broadcast, /stats_admin, /ban, /unban.
# Comma-separated. Find your ID by messaging @userinfobot on Telegram.
ADMIN_USER_IDS=

# Birdeye API key for Solana DEX alerts (free key at https://birdeye.so/).
# Leave empty to run without DEX alerts.
BIRDEYE_API_KEY=


# ---------------------------------------------------------------------
#  OPTIONAL - the values below are the defaults; delete or change them
# ---------------------------------------------------------------------

# Seconds between market scans. Lower = faster alerts but more API calls
# to every exchange (30 is a reasonable minimum).
SPIKE_CHECK_INTERVAL=60

# Daily gainer/loser alert band, in percent (+30% to +70%, -30% to -70%).
MIN_SPIKE_THRESHOLD=30
MAX_SPIKE_THRESHOLD=70

# Exchanges scanned for alerts, comma-separated.
# Choose from: binance,bybit,mexc,bitget,gateio
# Remove any that are blocked in your VPS's region.
EXCHANGES=binance,bybit,mexc,bitget,gateio

# Bybit regional endpoint: bybit.com (global), bybit.us, bybit.eu
BYBIT_HOSTNAME=bybit.com

# Days of alert history kept in MongoDB. Older alerts are deleted
# automatically. Minimum 1.
ALERT_HISTORY_DAYS=7

# Solana DEX tracking. Only runs when BIRDEYE_API_KEY is set.
# Set to false to turn it off even with a key.
DEX_ENABLED=true
# Minimum single buy (USD) for a DEX "big buy" alert, and for a whale alert.
DEX_BIG_BUY_USD=5000
DEX_WHALE_BUY_USD=25000

# Label for your deployment (development or production). Informational;
# the bot currently behaves the same either way.
ENVIRONMENT=production
