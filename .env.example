# Telegram Bot Token from @BotFather (required)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# MongoDB connection string (required)
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Monitoring
# Seconds between market scans
SPIKE_CHECK_INTERVAL=60
# Daily gainer/loser alert band, in percent
MIN_SPIKE_THRESHOLD=30
MAX_SPIKE_THRESHOLD=70

# Days of alert history to keep in MongoDB (older alerts are deleted automatically)
ALERT_HISTORY_DAYS=7

# Exchanges to monitor for alerts (comma-separated)
EXCHANGES=binance,bybit,mexc,bitget,gateio

# Bybit regional endpoint: bybit.com, bybit.us, bybit.eu
BYBIT_HOSTNAME=bybit.com

# Comma-separated Telegram user IDs with admin access
ADMIN_USER_IDS=

# Solana DEX tracking - only runs when BIRDEYE_API_KEY is set (free key at https://birdeye.so/)
DEX_ENABLED=true
BIRDEYE_API_KEY=
DEX_BIG_BUY_USD=5000
DEX_WHALE_BUY_USD=25000

ENVIRONMENT=development
